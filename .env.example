# 복사해서 .env로 만들어 쓴다. .env는 커밋하지 않는다.
MYSQL_ROOT_PASSWORD=root_local
DB_URL=jdbc:mysql://localhost:3307/learnershigh_credit
DB_USERNAME=credit
DB_PASSWORD=credit_local

# 프론트: true면 mock 데이터, false면 실제 API(/api → localhost:8080)를 쓴다. 기본값 true
VITE_USE_MOCK=true

# 세특 방향 추천(Claude API). 값은 여기에도 .env에도 커밋하지 않는다.
# 백엔드(Spring)는 이 파일을 자동으로 읽지 않으므로, 쓰려면 bootRun을 실행하는 셸에서 환경변수로 내보낸다.
# 키가 없으면 로드맵 기반 고정 안내 3안으로 대체한다(기능은 그대로 동작).
#   ANTHROPIC_API_KEY            Claude API 키 (필수일 때만, 값 없이 둠)
#   RECORD_AI_MODEL              모델 이름 (기본 claude-opus-5-5)
#   RECORD_AI_TIMEOUT_SECONDS    호출 제한 시간(초) (기본 60)
#   RECORD_AI_MAX_TOKENS         최대 출력 토큰 (기본 16000)
